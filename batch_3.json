[{"id": 31, "tag": "P009_3", "raw": "Stryver?", "en": "", "ko": "", "is_header": false}, {"id": 32, "tag": "P009_4", "raw": "How do you do, sir?” and shook hands.", "en": "", "ko": "", "is_header": false}, {"id": 33, "tag": "P009_5", "raw": "There was a peculiarity in his manner of shaking hands, always to be seen in any clerk at Tellson’s who shook hands with a customer when the House pervaded the air.", "en": "", "ko": "", "is_header": false}, {"id": 34, "tag": "P009_6", "raw": "He shook in a self-abnegating way, as one who shook for Tellson and Co.", "en": "", "ko": "", "is_header": false}, {"id": 35, "tag": "P010_1", "raw": "“Can I do anything for you, Mr.", "en": "", "ko": "", "is_header": false}, {"id": 36, "tag": "P010_2", "raw": "Stryver?” asked Mr.", "en": "", "ko": "", "is_header": false}, {"id": 37, "tag": "P010_3", "raw": "Lorry, in his business character.", "en": "", "ko": "", "is_header": false}, {"id": 38, "tag": "P011_1", "raw": "“Why, no, thank you;", "en": "", "ko": "", "is_header": false}, {"id": 39, "tag": "P011_2", "raw": "this is a private visit to yourself, Mr.", "en": "", "ko": "", "is_header": false}, {"id": 40, "tag": "P011_3", "raw": "Lorry;", "en": "", "ko": "", "is_header": false}]