[{"id": 171, "tag": "P058_3", "raw": "What am I thinking of!”", "en": "", "ko": "", "is_header": false}, {"id": 172, "tag": "P059_1", "raw": "“And I have no doubt,” said Mr.", "en": "", "ko": "", "is_header": false}, {"id": 173, "tag": "P059_2", "raw": "Lorry, “that I was right in the conversation we had.", "en": "", "ko": "", "is_header": false}, {"id": 174, "tag": "P059_3", "raw": "My opinion is confirmed, and I reiterate my advice.”", "en": "", "ko": "", "is_header": false}, {"id": 175, "tag": "P060_1", "raw": "“I assure you,” returned Mr.", "en": "", "ko": "", "is_header": false}, {"id": 176, "tag": "P060_2", "raw": "Stryver, in the friendliest way, “that I am sorry for it on your account, and sorry for it on the poor father’s account.", "en": "", "ko": "", "is_header": false}, {"id": 177, "tag": "P060_3", "raw": "I know this must always be a sore subject with the family;", "en": "", "ko": "", "is_header": false}, {"id": 178, "tag": "P060_4", "raw": "let us say no more about it.”", "en": "", "ko": "", "is_header": false}, {"id": 179, "tag": "P061_1", "raw": "“I don’t understand you,” said Mr.", "en": "", "ko": "", "is_header": false}, {"id": 180, "tag": "P061_2", "raw": "Lorry.", "en": "", "ko": "", "is_header": false}]