 },
 {
  "id": 7,
  "tag": "P0007",
  "chapter_id": "ch_07",
  "type": "passage",
  "editorial": false,
  "src": "안이그건도나안이될나요그러면너죽어될것잇다너는죽어경주인경도되고나말고전주인경도될나말고송도인경도되고나말고장안종노인경되고나는죽어인경마치되야삼십삼천이십팔숙을응하야질마재봉화세자루뻐지고남산봉화두자루뻐지면인경첫마듸치난소래그저뎅뎅칠때마다다른사람듯기에는인경소리로만알어도우리속으로는춘향뎅도련임뎅이라만나보자구나사랑랑내간내간내사랑이야",
  "sentences": []
 },
 {
  "id": 8,
  "tag": "P0008",
  "chapter_id": "ch_07",
  "type": "passage",
  "editorial": false,
  "src": "안이그것도나는실소그러면너죽어될것잇다너는죽어방이확이되고나는죽어방이고가되야경신연경신월경신일경신시의강태공조작방이그저떨구덩구덩찍거들난날린줄알여무나사랑사랑내사랑내간내간사랑이야",
  "sentences": []
 },
 {
