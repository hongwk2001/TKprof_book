 {
  "id": 870,
  "tag": "P0870",
  "chapter_id": "ch_20",
  "act": 4,
  "scene": 4,
  "type": "speech",
  "speaker": "CAPULET",
  "delivery": null,
  "raw": "Come, stir, stir, stir! The second cock hath crow’d,\nThe curfew bell hath rung, ’tis three o’clock.\nLook to the bak’d meats, good Angelica;\nSpare not for cost.",
  "sentences": [
   {
    "n": 1,
    "en": "Come, stir, stir, stir!",
    "ko": ""
   },
   {
    "n": 2,
    "en": "The second rooster has crowed.",
    "ko": ""
   },
   {
    "n": 3,
    "en": "The curfew bell has rung.",
    "ko": ""
   },
   {
    "n": 4,
    "en": "It is three o'clock.",
    "ko": ""
   },
   {
    "n": 5,
    "en": "Check on the baked meats, Angelica.",
    "ko": ""
   },
   {
    "n": 6,
    "en": "Do not worry about the cost.",
    "ko": ""
   }
  ]
 },
 {
  "id": 871,
  "tag": "P0871",
  "chapter_id": "ch_20",
  "act": 4,
  "scene": 4,
  "type": "speech",
  "speaker": "NURSE",
  "delivery": null,
  "raw": "Go, you cot-quean, go,\nGet you to bed; faith, you’ll be sick tomorrow\nFor this night’s watching.",
  "sentences": [
   {
    "n": 1,
    "en": "Go, you old housewife, go.",
    "ko": ""
   },
   {
    "n": 2,
    "en": "Go to bed.",
    "ko": ""
   },
   {
    "n": 3,
    "en": "I promise you will be sick tomorrow.",
    "ko": ""
   },
   {
    "n": 4,
    "en": "You will be sick from staying awake tonight.",
    "ko": ""
   }
  ]
 },
 {
  "id": 872,
  "tag": "P0872",
  "chapter_id": "ch_20",
  "act": 4,
  "scene": 4,
  "type": "speech",
  "speaker": "CAPULET",
  "delivery": null,
  "raw": "No, not a whit. What! I have watch’d ere now\nAll night for lesser cause, and ne’er been sick.",
  "sentences": [
   {
    "n": 1,
    "en": "No, not at all.",
    "ko": ""
   },
   {
    "n": 2,
    "en": "What!",
    "ko": ""
   },
   {
    "n": 3,
    "en": "I have watched all night before for smaller reasons.",
    "ko": ""
   },
   {
    "n": 4,
    "en": "I was never sick then.",
    "ko": ""
   }
  ]
 },
 {
  "id": 873,
  "tag": "P0873",
  "chapter_id": "ch_20",
  "act": 4,
  "scene": 4,
  "type": "speech",
  "speaker": "LADY CAPULET",
  "delivery": null,
  "raw": "Ay, you have been a mouse-hunt in your time;\nBut I will watch you from such watching now.",
  "sentences": [
   {
    "n": 1,
    "en": "Yes, you were a real woman-chaser in your day.",
    "ko": ""
   },
   {
    "n": 2,
    "en": "But I will keep an eye on you now, so you do not stay up for that.",
    "ko": ""
   }
  ]
 },
