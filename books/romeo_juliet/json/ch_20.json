  "drafts": {
   "gemma4_gloss": [
    {
     "en": "Go, you lazy person, go."
    },
    {
     "en": "Go to bed."
    },
    {
     "en": "I promise you will be sick tomorrow."
    },
    {
     "en": "You will be sick from staying awake tonight."
