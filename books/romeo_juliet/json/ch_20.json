  "scene": 4,
  "type": "speech",
  "speaker": "CAPULET",
  "delivery": null,
  "raw": "Mass and well said; a merry whoreson, ha.\nThou shalt be loggerhead.—Good faith, ’tis day.\nThe County will be here with music straight,\nFor so he said he would. I hear him near.",
  "sentences": [
   {
    "n": 1,
    "en": "By God, well said.",
    "ko": ""
   },
   {
    "n": 2,
    "en": "You funny rascal, ha!",
    "ko": ""
   },
   {
    "n": 3,
    "en": "You will be head of the logs, you blockhead.",
    "ko": ""
   },
   {
    "n": 4,
    "en": "My goodness, it is day.",
    "ko": ""
   },
   {
    "n": 5,
    "en": "The Count will be here with music soon.",
    "ko": ""
   },
   {
    "n": 6,
    "en": "He said he would come.",
    "ko": ""
   },
   {
    "n": 7,
    "en": "I hear him nearby.",
    "ko": ""
   }
  ]
 },
