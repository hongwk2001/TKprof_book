[{"id": 61, "tag": "P018_2", "raw": "Lorry adjusted his little wig at both ears as a means towards that end, and bit the feather of a pen.", "en": "", "ko": "", "is_header": false}, {"id": 62, "tag": "P019_1", "raw": "“D--n it all, sir!” said Stryver, staring at him, “am I not eligible?”", "en": "", "ko": "", "is_header": false}, {"id": 63, "tag": "P020_1", "raw": "“Oh dear yes!", "en": "", "ko": "", "is_header": false}, {"id": 64, "tag": "P020_2", "raw": "Yes.", "en": "", "ko": "", "is_header": false}, {"id": 65, "tag": "P020_3", "raw": "Oh yes, you’re eligible!” said Mr.", "en": "", "ko": "", "is_header": false}, {"id": 66, "tag": "P020_4", "raw": "Lorry. “If you say eligible, you are eligible.”", "en": "", "ko": "", "is_header": false}, {"id": 67, "tag": "P021_1", "raw": "“Am I not prosperous?” asked Stryver.", "en": "", "ko": "", "is_header": false}, {"id": 68, "tag": "P022_1", "raw": "“Oh! if you come to prosperous, you are prosperous,” said Mr.", "en": "", "ko": "", "is_header": false}, {"id": 69, "tag": "P022_2", "raw": "Lorry.", "en": "", "ko": "", "is_header": false}, {"id": 70, "tag": "P023_1", "raw": "“And advancing?”", "en": "", "ko": "", "is_header": false}]